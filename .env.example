# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only. Never expose to the browser / never prefix with NEXT_PUBLIC.
# Used by lib/supabase/admin.ts for privileged operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only. Postgres connection string for Drizzle (lib/db).
# Supabase Dashboard > Project Settings > Database.
#  - App runtime: Transaction pooler URI, port 6543 (add ?pgbouncer=true)
#  - drizzle-kit (pull/generate/migrate/push/studio): Session pooler or
#    direct URI, port 5432

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.doefwblwhyeikmnnvjkl:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"
